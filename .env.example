# =============================================================================
# Tajeer Rental Dashboard — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — only `.env.example` should be in version control.
# =============================================================================

# ─────────────────────────────── Runtime ───────────────────────────────
# Node environment: "development" or "production"
NODE_ENV=development

# Port the Express server listens on
PORT=3000

# Public URL where this app is deployed (used for OAuth callbacks, links)
# Local dev:  http://localhost:3000
# Production: https://your-domain.com
PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────── Database (MySQL) ───────────────────────────
# MySQL connection string (Drizzle ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local example: mysql://root:yourpassword@localhost:3306/tajeer_local
DATABASE_URL=mysql://root:changeme@localhost:3306/tajeer_local

# ──────────────────────────── Authentication ────────────────────────────
# Secret used to sign JWT session cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex-string

# OAuth — Manus infrastructure
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im
OWNER_OPEN_ID=your-owner-open-id

# ──────────────────────── Local Auth (Dev Only) ────────────────────────
# Enable local username/password login for offline development
LOCAL_AUTH_ENABLED=false
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=changeme

# ────────────────────── LLM / AI (Forge API) ──────────────────────
# Manus Forge API for LLM capabilities (AI writing assistant, etc.)
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ─────────────────────────── Email (Resend) ───────────────────────────
# Resend API for transactional emails (password reset, notifications)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@your-domain.com

# ──────────────────────────── Optional ────────────────────────────
# Custom Arabic font path (default uses system font if unset)
TAJEERK_ARABIC_FONT=

# Analytics (Umami) — optional, leave empty to disable
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
